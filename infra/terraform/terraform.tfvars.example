# Copia a  terraform.tfvars  y completa. (terraform.tfvars está en .gitignore.)

aws_region    = "us-east-1"
instance_type = "t3.small"

# Genera con: python -c "import secrets; print(secrets.token_urlsafe(50))"
secret_key = "cambia-esto-por-una-clave-larga-y-aleatoria"

# Dominio o IP pública; usa "*" solo para pruebas.
allowed_hosts = "*"

# Token DRF con el que la UI llama a la API; cloud-init lo crea en la base (usuario 'ui').
# Genera con: python -c "import secrets; print(secrets.token_hex(20))"
api_token = "cambia-esto-por-40-hex"

# Owner de las imágenes en GHCR y tag a desplegar. `latest` NO existe en GHCR (el CI solo
# publica semver+sha): usa un tag real, p. ej. el último `git tag --list 'v*'`.
images_owner = "nicolasandrescl"
image_tag    = "v1.0.0"

# Opcional: key pair EC2 para SSH y tu IP para restringir el acceso.
# ssh_key_name     = "mi-keypair"
# ssh_ingress_cidr = "TU.IP.PUBLICA.0/32"
