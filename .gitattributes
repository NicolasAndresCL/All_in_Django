# Los hooks y scripts POSIX DEBEN llevar LF: con CRLF, /bin/sh falla con
# "bad interpreter" o SC1017 y el hook deja de ejecutarse en silencio.
.githooks/* text eol=lf
docker/*.sh text eol=lf
*.sh text eol=lf
# La plantilla cloud-init es un script bash que Terraform lee del DISCO (templatefile) y
# manda a la EC2 tal cual: con CRLF el shebang es "#!/bin/bash\r" y cloud-init no la
# ejecuta. terraform test lo comprueba (tests/infra.tftest.hcl).
infra/terraform/templates/*.tftpl text eol=lf
