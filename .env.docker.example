# Variables para docker compose. Copia a  .env.docker  y ajusta.
# (.env.docker está en .gitignore; NO lo subas.)

# --- Django (lee core/conf.py) ---
# Genera una clave: python -c "import secrets; print(secrets.token_urlsafe(50))"
# Es OBLIGATORIA: el compose usa ${SECRET_KEY:?...}, así que sin ella el stack no arranca
# (mejor un fallo ruidoso que servir tráfico con una clave débil).
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DEBUG=False
# Incluye el nombre del servicio 'api' para el healthcheck interno y localhost para el host.
ALLOWED_HOSTS=localhost,127.0.0.1,api
# Si sirves el admin tras https/proxy, añade el origen (con esquema):
CSRF_TRUSTED_ORIGINS=
# Detrás de TLS real (proxy/Ingress con certificado) activa el bloque HTTPS completo
# (SSL redirect + HSTS + cookies secure). En Compose local déjalo apagado (HTTP plano).
# SECURE_HTTPS=True

# Rate limiting de la API (opcional; defaults: 60/min anon, 300/min user, 10/min token).
# THROTTLE_ANON=60/min
# THROTTLE_USER=300/min
# THROTTLE_TOKEN=10/min

# --- PostgreSQL (servicio 'db', imagen postgres:18-alpine) ---
# docker-compose.yml arma DATABASE_URL a partir de estas variables.
#
# OJO con el volumen: postgres:18 movió PGDATA a /var/lib/postgresql/18/docker y su VOLUME
# a /var/lib/postgresql (en la 16 ambos eran /var/lib/postgresql/data). El compose ya monta
# el volumen 'pgdata' en la ruta correcta; si alguna vez lo cambias a la ruta antigua, los
# datos se escribirán en un volumen ANÓNIMO y se perderán al recrear el contenedor, sin un
# solo error en el log.
#
# POSTGRES_PASSWORD solo se aplica al INICIALIZAR el volumen: cambiarla después no cambia
# la contraseña de la base ya creada (hay que hacer ALTER ROLE dentro del contenedor).
POSTGRES_USER=all_in_django
POSTGRES_PASSWORD=cambia-esto-tambien
POSTGRES_DB=all_in_django

# --- Token de la API para la UI (la API exige autenticación) ---
# Es OBLIGATORIO: el compose usa ${API_TOKEN:?...}. Sin él la UI levantaría "sana" pero
# daría 401 en cada vista, que es justo el fallo silencioso que se quiere evitar.
# Tras el primer 'up': crea usuario y token dentro del contenedor api y pégalo aquí.
#   docker compose --env-file .env.docker exec api python manage.py createsuperuser
#   docker compose --env-file .env.docker exec api python manage.py drf_create_token <usuario>
# (Si restauraste un dump que ya trae la tabla authtoken_token, reutiliza ese token.)
API_TOKEN=

# --- Puertos publicados en el HOST (opcional) ---
# Solo hace falta tocarlos si otro stack de la máquina ya ocupa esos puertos.
# API_PORT=8000
# UI_PORT=8501
# DB_PORT=5433

# Nota: DATABASE_URL NO se define aquí; el compose la construye apuntando a 'db:5432'.

# --- Imágenes GHCR (solo para el compose de DESPLIEGUE docker-compose.deploy.yml / CD) ---
# El Jenkinsfile inyecta IMAGE_TAG; REGISTRY e IMAGE_OWNER tienen defaults.
# El CI de Actions NO publica `latest`: usa el semver publicado (p. ej. 1.0.0 o 1.0).
# El compose de despliegue exige IMAGE_TAG (${IMAGE_TAG:?...}) y el Jenkinsfile aborta si
# vale 'latest', porque esa etiqueta no existe en GHCR.
# REGISTRY=ghcr.io
# IMAGE_OWNER=nicolasandrescl
# IMAGE_TAG=1.0.0
